# ─────────────────────────────────────────────────────────────────────────
# Python backend env. The frontend's `.env` should NOT duplicate any of
# these — the only frontend-side variable that mentions this service is
# `BACKEND_URL`, which points at it.
# ─────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase Postgres) ────────────────────────────────────────
# Use the asyncpg driver scheme — postgresql+asyncpg://...
# Get the password from Supabase → Project Settings → Database → Connection
# string → "URI" tab. Use the pooler URL (...pooler.supabase.com:5432).
DATABASE_URL=postgresql+asyncpg://postgres:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Synchronous URL used by Alembic + seeders. Same DB, different driver
# (psycopg2). If you don't set it explicitly, the app derives it from
# DATABASE_URL by swapping +asyncpg → +psycopg2.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Auth (JWT) ──────────────────────────────────────────────────────────
# 32+ byte random string. Use:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-32-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

# ─── Module Entitlement & Licensing ─────────────────────────────────────
# The app fails CLOSED with no licence (every module locks). Provide ONE of:
#   • LICENCE_TOKEN — the full signed token. Best for cloud/container deploys
#     (Vercel/Dokploy) whose filesystem is ephemeral. Get it from a .lic file:
#     `cat clients/<customer>.lic`. The token is signed, not secret — safe to
#     put in env. This is the recommended way to license a hosted deployment.
#   • LICENCE_FILE_PATH — path to a .lic file (default: <backend>/licence.lic).
#     Best for on-prem where you drop the file on disk / a mounted volume.
# A file, when present, takes precedence over LICENCE_TOKEN.
# LICENCE_TOKEN=
# LICENCE_FILE_PATH=
# LICENCE_WARN_DAYS=14

# ─── Super Admin (organisation owner) ────────────────────────────────────
# The account that decides which licensed modules this organisation uses
# (/organisation/modules). Authority normally comes from the SUPER_ADMIN role;
# this is the break-glass anchor so the organisation is never left with nobody
# able to reach that screen. Set the SAME value on the Next.js side.
# SUPER_ADMIN_EMAIL=info@cgbindia.com

# ─── Supabase Storage ────────────────────────────────────────────────────
# Required for incident attachments. Service-role key — NEVER expose to the
# browser. The frontend talks to the backend, the backend talks to Supabase.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_INCIDENT_BUCKET=incident-attachments

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins. Add your Vercel URL when
# deploying to production. The Next.js BFF and the browser BOTH need to be
# allowed when fetching from the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── AI Agents (Anthropic) ──────────────────────────────────────────────
# Used by:
#   • TriageAgent — runs on observation submission, suggests
#     severity / category / priority + first-response prompts.
#   • LessonsDistributionAgent — runs on observation closure, generates a
#     sharable lesson + target audience + follow-up actions.
# Optional — when ANTHROPIC_API_KEY is unset the agents log + skip; the
# workflow itself keeps working.
ANTHROPIC_API_KEY=
# Default to Haiku for cost; override per-agent in code if you need
# Sonnet/Opus quality. https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Notifications — Email (SMTP / nodemailer-compatible) ─────────────
# Used by the auto-promotion service (Critical Near Miss → Incident
# alert) and future workflow escalation cron. Optional — when unset,
# notifications log + no-op; the workflow itself keeps working.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=
EMAIL_FROM=SafeOps360 Alerts <alerts@example.com>

# Origin of the WEB app (not this API). Every link inside an outbound email
# is built from it — audit-assignment notifications and the supplier
# corrective-action portal.
#
# Leave it unset and those emails still send, but their links degrade to bare
# paths like /cams/audits/<id>, which are not clickable from a mail client.
# Set it in every deployed environment.
#
# Links are emitted as {APP_PUBLIC_URL}/go?to=<path>: the /go route reads the
# reader's session and either opens the record directly or sends them to
# /login?callbackUrl=<path> and returns them there after sign-in — so one link
# works whether or not the recipient is still signed in.
APP_PUBLIC_URL=https://safeops360.example.com

# ─── Notifications — SMS (MSG91 default, Twilio fallback) ─────────────
# MSG91 is cheap + India DLT-compliant (₹0.15-0.25 per SMS). Set
# MSG91_AUTH_KEY (and MSG91_TEMPLATE_ID for DLT-registered flows) to
# enable. If both providers are configured, MSG91 is tried first.
MSG91_AUTH_KEY=
MSG91_SENDER=SAFEOP
MSG91_TEMPLATE_ID=
# Twilio fallback — leave blank if not using
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── CAMS calendar bookings (Microsoft 365 / Teams) ──────────────────────
# When an audit is scheduled, SafeOps360 books the fieldwork window plus the
# opening and closing meetings in the participants' calendars. It degrades one
# rung at a time rather than all-or-nothing:
#
#   Graph credentials below  → the meeting is written straight into each
#                              attendee's Microsoft 365 calendar, showing as
#                              BUSY without them accepting, with a Teams link.
#   SMTP only (above)        → .ics invitations by email. They land in Outlook
#                              and Teams, but the time is held only once the
#                              recipient accepts, and there is no Teams link.
#   neither                  → bookings are recorded and shown in the audit
#                              screen as "Not sent". Nothing is emailed.
#
# The middle rung is what makes this usable before a customer's IT finishes an
# Azure app registration — which is never same-day.
CALENDAR_BOOKINGS_ENABLED=true

# Azure app registration (client credentials / app-only). In Entra ID:
#   App registrations → New registration → API permissions →
#   Microsoft Graph → APPLICATION permissions (not delegated — nobody is
#   signed in when a scheduler books a calendar):
#       Calendars.ReadWrite  — the ONLY one required, and it yields the Teams
#                              join link too (Exchange honours isOnlineMeeting
#                              at event creation; verified 2026-08-06).
#                              OnlineMeetings.ReadWrite governs the standalone
#                              /onlineMeetings API, which is never called here.
#                              User.Read.All is not needed either — attendee
#                              addresses come from the local User table.
#   → then "Grant admin consent for <tenant>". Without consent every call 403s.
# Certificates & secrets → New client secret → copy the VALUE (not the ID).
#
# These also accept the MICROSOFT_APP_* / MICROSOFT_* names used by CGB's other
# deployments, so one credential set serves both rather than being duplicated.
# Precedence: MS_GRAPH_* → MICROSOFT_APP_* → MICROSOFT_*.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# Sovereign clouds only (GCC High / China) — the scope is derived from this.
# MS_GRAPH_BASE=https://graph.microsoft.com/v1.0
# MS_LOGIN_BASE=https://login.microsoftonline.com

# Mailbox that organises a booking when the lead auditor has no email address
# on file (external lead, service account, seat removed). Must be a REAL
# mailbox in the tenant — Graph writes the event into it. With neither this nor
# a lead auditor address, the booking is recorded as skipped rather than guessed.
# CALENDAR_ORGANIZER_EMAIL=audits@example.com

# IANA zone the audit's local start time is composed in. `scheduledStartTime`
# is a wall-clock "HH:MM"; this is the zone that turns it into an instant.
CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata

# Opening / closing meeting length, in minutes, carved out of the audit window.
# A window too short for both shrinks them rather than letting them overlap.
CALENDAR_OPENING_MEETING_MINUTES=30
CALENDAR_CLOSING_MEETING_MINUTES=30

# How far ahead an Exchange room mailbox accepts a booking. Exchange's own
# default is 180 days (BookingWindowInDays) and a room DECLINES anything beyond
# it — verified: 30 days accepted, 200 declined. Because the Annual Audit
# Programme schedules a year out, a booking past this window is sent WITHOUT the
# room and the room is attached automatically once the date comes into range.
# Raise it only if the tenant's rooms are configured more generously.
CALENDAR_ROOM_BOOKING_WINDOW_DAYS=180

# Give up delivering a booking after this many attempts. It then shows as
# "Could not be delivered" on the audit screen with the provider's own error,
# rather than being retried forever in silence.
CALENDAR_MAX_ATTEMPTS=6
# Attach a Teams join link. Graph only — .ics invitations cannot create one.
CALENDAR_ONLINE_MEETINGS=true

# ─── Server ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Accounts the login page demo picker may reveal beyond the @safeops360.in demo
# domain, comma-separated. Explicit addresses only — /api/auth/demo-search
# answers before anyone signs in, so a whole domain here would let the login
# page enumerate real staff.
DEMO_SEARCH_EXTRA_EMAILS=
